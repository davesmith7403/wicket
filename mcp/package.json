{
  "name": "wicket-mcp",
  "version": "2.5.0",
  "description": "Model Context Protocol server fronting Wicket \u2014 exposes the Wicket operations as native MCP tools.",
  "type": "module",
  "private": true,
  "bin": {
    "wicket-mcp": "./src/index.ts"
  },
  "files": [
    "src",
    "skill"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "skill:sync": "bun run scripts/sync-skill.ts",
    "plugin:build": "bun run scripts/build-plugin.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/identity-cache-persistence": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
