# Wicket MCP server configuration
# Copy to .env and fill in. The .env file is gitignored — never commit real secrets.

# --- Entra ID (Azure AD) tenant that owns the BC environment ---
# GUID of your tenant, e.g. 11111111-2222-3333-4444-555555555555
BC_TENANT_ID=

# --- Business Central environment + company ---
# The BC environment (sandbox / production) name, e.g. "PRODUCTION" or "SANDBOX"
BC_ENVIRONMENT=PRODUCTION
# The company GUID (systemId) that requests are scoped to. This is the id that
# appears in companies({companyId}) in the URL. Get it from the Wicket discover
# (kind=companies) op or from BC's /companies endpoint.
BC_COMPANY_ID=

# --- Service principal (OAuth2 client_credentials) ---
# Entra ID app registration that has an S2S "Microsoft Entra Applications" entry
# in BC with the Wicket permission sets assigned. See docs/setup-entra.md.
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# --- Optional overrides ---
# Base URL of the BC API host. Defaults to the SaaS Online host derived from
# tenant + environment:
#   https://api.businesscentral.dynamics.com/v2.0/{BC_TENANT_ID}/{BC_ENVIRONMENT}
# Set this only for a non-default host (e.g. a regional endpoint or a proxy).
# BC_BASE_URL=

# The `origin` tag stamped on every envelope by this (the env `default`) connection.
# Must be <=256 chars matching [A-Za-z0-9._@/+-:]. Defaults to
# "mcp.wicket/<server version>+<connection>" (see SERVER_VERSION in src/index.ts).
# BC_ORIGIN=
